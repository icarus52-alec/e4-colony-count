rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing recipe library: public read, owner write.
    match /libraries/master {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == 'ljJlyQ360cPg3kVzxngvHsm2Kco1';
    }

    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == 'ljJlyQ360cPg3kVzxngvHsm2Kco1'
                  && userId == 'ljJlyQ360cPg3kVzxngvHsm2Kco1';
      allow write: if false;
    }

    // E4 sync only: counts and original-photo filename metadata, never image data.
    match /e4Owners/{userId}/sessions/{sessionId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == 'ljJlyQ360cPg3kVzxngvHsm2Kco1'
                         && userId == request.auth.uid;
    }
  }
}
